{
  "name": "gridfall",
  "version": "0.2.0",
  "private": true,
  "description": "A Sudoku tower-defense game and reusable voxel game foundation by Yak Studios.",
  "desktopName": "studio.yak.gridfall",
  "author": "Yak Studios",
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/check-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "desktop:dev": "electron . --windowed",
    "package:linux": "npm run build && electron-builder --linux AppImage dir --x64 --publish never",
    "package:linux:dir": "npm run build && electron-builder --linux dir --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "studio.yak.gridfall",
    "productName": "Gridfall",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "package.json"],
    "linux": {
      "target": ["AppImage", "dir"],
      "category": "Game",
      "executableName": "gridfall",
      "syncDesktopName": true,
      "icon": "desktop/icon.png",
      "artifactName": "Gridfall-${version}-${arch}.${ext}"
    }
  }
}
